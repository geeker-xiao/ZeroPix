# Generated binaries and installers. Rebuild with
# CGO_ENABLED=1 go tool mygo build -platform windows/amd64
/build/
/.mygo/
mygo_windows_*.syso
# A bare `go build -o <name>.exe .` drops the binary in the repo root.
/*.exe

